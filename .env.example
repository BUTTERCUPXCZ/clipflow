# Copy to .env (root) and fill in. Every app reads this one file.

# --- PostgreSQL (local) ---
# Unix socket + peer auth: connects as your OS user, no password stored.
# Adjust port to your cluster (`pg_lsclusters`).
DATABASE_URL=postgresql:///clipforge?host=/var/run/postgresql&port=5433

# --- NestJS API ---
# Changing API_PORT (or VITE_API_URL) also requires updating connect-src in
# apps/desktop/src-tauri/tauri.conf.json, or the desktop webview blocks the requests.
# The desktop dev origin (port 1420) is fixed in apps/api/src/config/env.ts (DESKTOP_ORIGINS).
API_PORT=3000
# gRPC address of the Python AI service, as seen from NestJS
AI_GRPC_URL=localhost:50051

# --- Python AI service ---
AI_HTTP_PORT=8000
AI_GRPC_PORT=50051
JOB_EVENTS_GRPC_URL=localhost:50052
REDIS_URL=redis://localhost:6379/0
OLLAMA_BASE_URL=http://localhost:11434
MEDIA_ROOT=~/.local/share/clipforge/media

# --- Models / processing ---
VISION_MODEL=qwen3-vl:8b-instruct
TRANSCRIPTION_MODEL=small
MAX_CONCURRENT_ANALYSIS=1
MAX_CONCURRENT_RENDER=1
FRAME_SAMPLE_INTERVAL=1
FRAME_MAX_WIDTH=768

# --- Desktop (Vite exposes only VITE_* vars to the UI) ---
VITE_API_URL=http://localhost:3000/api/v1
